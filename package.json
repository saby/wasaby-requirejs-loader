{
   "name": "wasaby-requirejs-loader",
   "version": "25.6000.0",
   "description": "Колбешин Ф.А.",
   "scripts": {
      "prepare": "npm run update-cli-store && npm run initTypescript && wasaby-cli initGitHooks",
      "update-cli-store": "wasaby-cli loadProject",
      "initTypescript": "wasaby-cli initTSEnv",
      "build": "wasaby-cli buildProject --release",
      "build:watch": "wasaby-cli buildProject --watcher",
      "build:autodoc": "wasaby-cli buildAutodoc",
      "build:require-min": "npm install uglify-js@3.4.10 && node node_modules/uglify-js/bin/uglifyjs --compress --mangle -o RequireJsLoader/require.min.js -- RequireJsLoader/require.js",
      "start": "wasaby-cli runUnitTests --server",
      "test": "wasaby-cli runUnitTests --NodeJS --report=console",
      "test:coverage": "wasaby-cli runUnitTests --NodeJS --coverage",
      "build:Require": "node buildRequire.js",
      "prettier": "prettier --write .",
      "startServer": "wasaby-cli startServer --release"
   },
   "wasaby-cli": {
      "umd": true,
      "copy": true,
      "preCommitHooks": [
         "Prettier",
         "ESLint",
         "Stylelint"
      ],
      "rootReps": [
         "https://git.sbis.ru/saby/router.git",
         "https://git.sbis.ru/saby/wasaby-app.git",
         "https://git.sbis.ru/saby/wasaby-controls.git",
         "https://git.sbis.ru/sbis/engine.git",
         "https://git.sbis.ru/engine/saby-page",
         "https://git.sbis.ru/saby/site-editor",
         "https://git.sbis.ru/plugin/client",
         "https://git.sbis.ru/engine/help-system",
         "https://git.sbis.ru/navigation-configuration/configuration",
         "https://git.sbis.ru/sbis/ws",
         "https://git.sbis.ru/saby/ui"
      ]
   },
   "repository": {
      "type": "git",
      "url": "git+https://git.sbis.ru/saby/wasaby-requirejs-loader.git"
   },
   "author": "",
   "license": "MIT",
   "bugs": {
      "url": "https://git.sbis.ru/saby/wasaby-requirejs-loader/issues"
   },
   "homepage": "https://git.sbis.ru/saby/wasaby-requirejs-loader#readme",
   "files": [
      "RequireJsLoader/*",
      "WasabyLoader/*"
   ],
   "devDependencies": {
      "wasaby-cli": "git+ssh://git@git.sbis.ru:saby/wasaby-cli.git#rc-25.6000",
      "rollup": "4.52.4",
      "@rollup/plugin-terser": "0.4.4",
      "@rollup/plugin-typescript": "12.1.4",
      "p-map": "4.0.0"
   },
   "dependencies": {
      "uglify-js": "^3.4.10"
   }
}